version: 1
title: 吉林化纤30万千瓦风电项目
size: [960, 540]
theme:
  colors:
    primary: "#101D42"
    deep: "#0A1229"
    secondary: "#33508C"
    accent: "#F5B700"
    accentLight: "#FFD34D"
    accentDeep: "#8F6A00"
    bg: "#F2F5F9"
    ink: "#1A2233"
    muted: "#66738A"
    line: "#D5DCE8"
    panel: "#E6EBF3"
    frost: "#C7D3EC"
  textStyles:
    kicker: {fontSize: 12, color: "$secondary", fontFamily: 阿里妈妈数黑体, bold: true, letterSpacing: 3}
    pageTitle: {fontSize: 25, color: "$primary", fontFamily: 阿里妈妈数黑体, bold: true, lineHeight: 1.35}
    body: {fontSize: 14, color: "$ink", fontFamily: MiSans, lineHeight: 1.6}
    caption: {fontSize: 10, color: "$muted", fontFamily: MiSans, lineHeight: 1.4}
    bigNum: {fontSize: 40, color: "$primary", fontFamily: 阿里妈妈数黑体, bold: true}
  tableStyles:
    default:
      cellStyle:
        fontSize: 12.5
        color: "$ink"
        fontFamily: MiSans
        align: [center, middle]
        border: [null, null, {style: solid, width: 0.75, color: "$line"}, null]
      firstRowStyle:
        fill: {type: solid, color: "$primary"}
        color: "#FFFFFF"
        bold: true
        fontSize: 12.5
      bodyStyles:
        - fill: {type: solid, color: "#FFFFFF"}
        - fill: {type: solid, color: "$panel"}
pages:
  - pages/01_cover.page
  - pages/02_toc.page
  - pages/03_overview.page
  - pages/04_units.page
  - pages/05_direct.page
  - pages/06_timeline.page
  - pages/07_benefit.page
  - pages/08_loop.page
  - pages/09_policy.page
  - pages/10_outlook.page
  - pages/11_end.page