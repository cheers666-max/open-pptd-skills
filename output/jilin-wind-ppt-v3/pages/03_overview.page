pageType: content
background:
  type: solid
  color: "$bg"
notes: 项目概览：吉林省首批自带负荷配置新能源指标风电项目，国能吉林新能源通榆分公司建设，绿电直供吉林化纤。
elements:
  - elementId: kicker-tick
    elementType: shape
    bounds: [64, 32, 4, 16]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: kicker
    elementType: text
    bounds: [76, 30, 400, 20]
    content:
      style: "$kicker"
      text: "01 · 项目概览"

  - elementId: pageno
    elementType: text
    bounds: [800, 30, 96, 18]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      align: [right, top]
      text: "03 / 11"

  - elementId: title
    elementType: text
    bounds: [64, 54, 832, 36]
    content:
      style: "$pageTitle"
      text: "吉林省首批自带负荷配置新能源指标风电项目"

  - elementId: title-rule
    elementType: shape
    bounds: [64, 102, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  # 左栏：项目名片
  - elementId: info-1
    elementType: text
    bounds: [64, 124, 420, 44]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans; letter-spacing:1px;">项目名称</p>
        <p style="font-size:15px; color:$ink; font-family:MiSans; margin-top:3px;"><strong>吉林化纤自带负荷配置30万千瓦风电项目</strong></p>

  - elementId: info-line-1
    elementType: shape
    bounds: [64, 176, 420, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: info-2
    elementType: text
    bounds: [64, 190, 420, 44]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans; letter-spacing:1px;">建设地点</p>
        <p style="font-size:15px; color:$ink; font-family:MiSans; margin-top:3px;"><strong>吉林省白城市通榆县乌兰花镇</strong></p>

  - elementId: info-line-2
    elementType: shape
    bounds: [64, 242, 420, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: info-3
    elementType: text
    bounds: [64, 256, 420, 44]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans; letter-spacing:1px;">建设单位</p>
        <p style="font-size:15px; color:$ink; font-family:MiSans; margin-top:3px;"><strong>国能吉林新能源发展有限公司通榆分公司</strong></p>

  - elementId: info-line-3
    elementType: shape
    bounds: [64, 308, 420, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: info-4
    elementType: text
    bounds: [64, 322, 420, 44]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans; letter-spacing:1px;">用电负荷</p>
        <p style="font-size:15px; color:$ink; font-family:MiSans; margin-top:3px;"><strong>吉林化纤集团</strong><span style="font-size:12px; color:$muted;">　碳纤维等生产负荷</span></p>

  - elementId: info-line-4
    elementType: shape
    bounds: [64, 374, 420, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: info-5
    elementType: text
    bounds: [64, 388, 420, 44]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans; letter-spacing:1px;">总投资</p>
        <p style="font-size:15px; color:$ink; font-family:MiSans; margin-top:3px;"><strong>约 15 亿元</strong><span style="font-size:12px; color:$muted;">（公开报道口径）</span></p>

  - elementId: info-line-5
    elementType: shape
    bounds: [64, 440, 420, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: info-6
    elementType: text
    bounds: [64, 454, 420, 44]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans; letter-spacing:1px;">并网时间</p>
        <p style="font-size:15px; color:$ink; font-family:MiSans; margin-top:3px;"><strong>2025年12月13日</strong><span style="font-size:12px; color:$muted;">　正式并网发电</span></p>

  # 右栏：关键数字 2×2
  - elementId: num-1
    elementType: text
    bounds: [540, 128, 172, 150]
    content:
      text: |
        <p style="font-size:32px; color:$primary; font-family:阿里妈妈数黑体; font-weight:bold;">299.85<span style="font-size:14px; color:$secondary;"> MW</span></p>
        <p style="font-size:12px; color:$muted; font-family:MiSans; margin-top:8px;">总装机容量</p>

  - elementId: num-2
    elementType: text
    bounds: [718, 128, 172, 150]
    content:
      text: |
        <p style="font-size:32px; color:$primary; font-family:阿里妈妈数黑体; font-weight:bold;">42<span style="font-size:14px; color:$secondary;"> 台</span></p>
        <p style="font-size:12px; color:$muted; font-family:MiSans; margin-top:8px;">机组规模</p>
        <p style="font-size:10px; color:$muted; font-family:MiSans; margin-top:2px;">39×7.15MW + 3×7.0MW</p>

  - elementId: num-div-v
    elementType: shape
    bounds: [712, 148, 1, 110]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: num-div-h
    elementType: shape
    bounds: [540, 288, 350, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: num-3
    elementType: text
    bounds: [540, 300, 172, 150]
    content:
      text: |
        <p style="font-size:32px; color:$primary; font-family:阿里妈妈数黑体; font-weight:bold;">6.5<span style="font-size:14px; color:$secondary;"> 亿千瓦时</span></p>
        <p style="font-size:12px; color:$muted; font-family:MiSans; margin-top:8px;">年均发电量</p>

  - elementId: num-4
    elementType: text
    bounds: [718, 300, 172, 150]
    content:
      text: |
        <p style="font-size:32px; color:$primary; font-family:阿里妈妈数黑体; font-weight:bold;">160<span style="font-size:14px; color:$secondary;"> m</span></p>
        <p style="font-size:12px; color:$muted; font-family:MiSans; margin-top:8px;">轮毂中心高度</p>

  - elementId: footer-rule
    elementType: shape
    bounds: [64, 505, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: source-note
    elementType: text
    bounds: [64, 512, 560, 20]
    content:
      style: "$caption"
      text: "资料来源：国际新能源网、龙船风电网公开报道（2025.12）；投资额为公开报道口径"