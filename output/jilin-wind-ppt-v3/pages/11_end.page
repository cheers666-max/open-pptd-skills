pageType: end
background:
  type: solid
  color: "$deep"
notes: 结束页：绿电驱动未来。
elements:
  - elementId: bg-image
    elementType: image
    bounds: [0, 0, 960, 540]
    src: media/wind_turbine.jpg
    fit: cover

  - elementId: overlay
    elementType: shape
    bounds: [0, 0, 960, 540]
    shapeName: rect
    fill:
      type: gradient
      angle: 90
      stops:
        - {position: 0, color: "#0A1229CC"}
        - {position: 0.5, color: "#0A122999"}
        - {position: 1, color: "#0A1229E6"}

  # 装饰风机（左下，低透明度）
  - elementId: deco-blade-up
    elementType: shape
    bounds: [106, 400, 8, 70]
    shapeName: ellipse
    rotation: 0
    fill: {type: solid, color: "#FFFFFF", opacity: 0.15}

  - elementId: deco-blade-120
    elementType: shape
    bounds: [136.3, 450, 8, 70]
    shapeName: ellipse
    rotation: 120
    fill: {type: solid, color: "#FFFFFF", opacity: 0.15}

  - elementId: deco-blade-240
    elementType: shape
    bounds: [75.7, 450, 8, 70]
    shapeName: ellipse
    rotation: 240
    fill: {type: solid, color: "#FFFFFF", opacity: 0.15}

  - elementId: deco-hub
    elementType: shape
    bounds: [104, 464, 12, 12]
    shapeName: ellipse
    fill: {type: solid, color: "#FFFFFF", opacity: 0.15}

  - elementId: kicker
    elementType: text
    bounds: [280, 180, 400, 20]
    content:
      fontSize: 12
      color: "$accentLight"
      fontFamily: MiSans
      letterSpacing: 4
      align: [center, top]
      text: "GREEN POWER · GREEN MATERIALS"

  - elementId: title
    elementType: text
    bounds: [180, 210, 600, 70]
    content:
      fontSize: 48
      color: "#FFFFFF"
      fontFamily: 阿里妈妈数黑体
      bold: true
      align: [center, middle]
      text: "绿电驱动未来"

  - elementId: subtitle
    elementType: text
    bounds: [180, 292, 600, 22]
    content:
      fontSize: 14
      color: "$frost"
      fontFamily: MiSans
      align: [center, top]
      text: "吉林化纤自带负荷配置30万千瓦风电项目"

  - elementId: rule
    elementType: shape
    bounds: [430, 332, 100, 1]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: source
    elementType: text
    bounds: [180, 486, 600, 16]
    content:
      fontSize: 10
      color: "#8FA0C8"
      fontFamily: MiSans
      align: [center, top]
      text: "资料来源：国际新能源网 · 龙船风电网 · 人民网 · 国家发改委官网 · 吉林化纤集团官网（2024.04–2026.08）"