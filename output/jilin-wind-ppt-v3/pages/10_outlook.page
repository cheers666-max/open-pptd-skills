pageType: content
background:
  type: solid
  color: "$bg"
notes: 未来展望：2.5万吨碳纤维项目在建、绿电持续供应、模式复制与产业集群。
elements:
  - elementId: kicker-tick
    elementType: shape
    bounds: [64, 32, 4, 16]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: kicker
    elementType: text
    bounds: [76, 30, 400, 20]
    content:
      style: "$kicker"
      text: "08 · 未来展望"

  - elementId: pageno
    elementType: text
    bounds: [800, 30, 96, 18]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      align: [right, top]
      text: "10 / 11"

  - elementId: title
    elementType: text
    bounds: [64, 54, 832, 36]
    content:
      style: "$pageTitle"
      text: "从一个风电场，到一个绿色产业集群"

  - elementId: title-rule
    elementType: shape
    bounds: [64, 102, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  # 左栏：三个展望
  - elementId: out-1-tag
    elementType: text
    bounds: [64, 140, 90, 28]
    content:
      fontSize: 20
      color: "$accentDeep"
      fontFamily: 阿里妈妈数黑体
      bold: true
      text: "2026"

  - elementId: out-1
    elementType: text
    bounds: [160, 140, 364, 76]
    content:
      text: |
        <p style="font-size:15px; color:$ink; font-family:MiSans;"><strong>2.5万吨碳纤维项目在建</strong></p>
        <p style="font-size:12.5px; color:$muted; font-family:MiSans; margin-top:6px; line-height:1.6;">配套绿电直连示范工程协同推进，绿电直送碳纤维生产线，源荷协同。</p>

  - elementId: out-rule-1
    elementType: shape
    bounds: [64, 228, 460, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: out-2-tag
    elementType: text
    bounds: [64, 248, 90, 28]
    content:
      fontSize: 20
      color: "$accentDeep"
      fontFamily: 阿里妈妈数黑体
      bold: true
      text: "持续"

  - elementId: out-2
    elementType: text
    bounds: [160, 248, 364, 76]
    content:
      text: |
        <p style="font-size:15px; color:$ink; font-family:MiSans;"><strong>绿电持续供应化纤集团</strong></p>
        <p style="font-size:12.5px; color:$muted; font-family:MiSans; margin-top:6px; line-height:1.6;">30万千瓦风电场持续向吉林化纤集团供应绿电，支撑碳纤维产品低碳化与出口竞争力提升。</p>

  - elementId: out-rule-2
    elementType: shape
    bounds: [64, 336, 460, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: out-3-tag
    elementType: text
    bounds: [64, 356, 90, 28]
    content:
      fontSize: 20
      color: "$accentDeep"
      fontFamily: 阿里妈妈数黑体
      bold: true
      text: "远期"

  - elementId: out-3
    elementType: text
    bounds: [160, 356, 364, 76]
    content:
      text: |
        <p style="font-size:15px; color:$ink; font-family:MiSans;"><strong>模式复制与产业集群</strong></p>
        <p style="font-size:12.5px; color:$muted; font-family:MiSans; margin-top:6px; line-height:1.6;">“自带负荷+绿电直连”模式向更多高载能场景复制，吉林“风光绿电×碳纤维”深度融合。</p>

  # 右栏：图片
  - elementId: photo
    elementType: image
    bounds: [560, 130, 336, 300]
    src: media/wind_field.jpg
    fit: cover

  - elementId: photo-overlay
    elementType: shape
    bounds: [560, 330, 336, 100]
    shapeName: rect
    fill:
      type: gradient
      angle: 90
      stops:
        - {position: 0, color: "#0A122900"}
        - {position: 1, color: "#0A1229CC"}

  - elementId: photo-quote
    elementType: text
    bounds: [576, 384, 304, 22]
    content:
      fontSize: 14
      color: "#FFFFFF"
      fontFamily: 阿里妈妈数黑体
      bold: true
      text: "从“一煤独大”到“绿电当家”"

  - elementId: photo-caption
    elementType: text
    bounds: [560, 438, 336, 16]
    content:
      fontSize: 10
      color: "$muted"
      fontFamily: MiSans
      text: "通榆风电场（示意）"

  - elementId: footer-rule
    elementType: shape
    bounds: [64, 505, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: source-note
    elementType: text
    bounds: [64, 512, 560, 20]
    content:
      style: "$caption"
      text: "资料来源：人民网（2026.08）、吉林化纤集团官网"