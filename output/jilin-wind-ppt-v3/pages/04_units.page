pageType: content
background:
  type: solid
  color: "$bg"
notes: 建设规模与技术路线：42台机组，160米轮毂高度，139米混塔+16.8米钢塔，叶轮直径216米。
elements:
  - elementId: kicker-tick
    elementType: shape
    bounds: [64, 32, 4, 16]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: kicker
    elementType: text
    bounds: [76, 30, 400, 20]
    content:
      style: "$kicker"
      text: "02 · 建设规模与技术路线"

  - elementId: pageno
    elementType: text
    bounds: [800, 30, 96, 18]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      align: [right, top]
      text: "04 / 11"

  - elementId: title
    elementType: text
    bounds: [64, 54, 832, 36]
    content:
      style: "$pageTitle"
      text: "42台大兆瓦风机，160米轮毂高度"

  - elementId: title-rule
    elementType: shape
    bounds: [64, 102, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  # 左栏：风机示意图（形状绘制）
  - elementId: sweep-circle
    elementType: shape
    bounds: [211, 171, 78, 78]
    shapeName: ellipse
    fill: {type: none}
    border: {style: dashed, width: 1, color: "$line"}

  - elementId: blade-up
    elementType: shape
    bounds: [244, 132, 12, 78]
    shapeName: ellipse
    rotation: 0
    fill: {type: solid, color: "$secondary", opacity: 0.9}

  - elementId: blade-120
    elementType: shape
    bounds: [277.8, 190.5, 12, 78]
    shapeName: ellipse
    rotation: 120
    fill: {type: solid, color: "$secondary", opacity: 0.9}

  - elementId: blade-240
    elementType: shape
    bounds: [210.2, 190.5, 12, 78]
    shapeName: ellipse
    rotation: 240
    fill: {type: solid, color: "$secondary", opacity: 0.9}

  - elementId: nacelle
    elementType: shape
    bounds: [238, 203, 24, 14]
    shapeName: rect
    fill: {type: solid, color: "$primary"}

  - elementId: hub
    elementType: shape
    bounds: [243, 203, 14, 14]
    shapeName: ellipse
    fill: {type: solid, color: "$accent"}

  - elementId: tower
    elementType: shape
    bounds: [246, 217, 8, 149]
    shapeName: rect
    fill: {type: solid, color: "$secondary"}

  - elementId: ground
    elementType: shape
    bounds: [140, 366, 220, 2]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  # 尺寸标注：轮毂高度
  - elementId: dim-hub-v
    elementType: shape
    bounds: [180, 210, 1, 156]
    shapeName: rect
    fill: {type: solid, color: "$secondary"}

  - elementId: dim-hub-top
    elementType: shape
    bounds: [176, 210, 9, 1]
    shapeName: rect
    fill: {type: solid, color: "$secondary"}

  - elementId: dim-hub-bottom
    elementType: shape
    bounds: [176, 365, 9, 1]
    shapeName: rect
    fill: {type: solid, color: "$secondary"}

  - elementId: dim-hub-label
    elementType: text
    bounds: [112, 268, 62, 36]
    content:
      text: |
        <p style="font-size:13px; color:$primary; font-family:阿里妈妈数黑体; font-weight:bold;">160 m</p>
        <p style="font-size:10px; color:$muted; font-family:MiSans;">轮毂高度</p>

  # 尺寸标注：叶轮直径
  - elementId: dim-rotor-leader
    elementType: shape
    bounds: [289, 172, 8, 1]
    shapeName: rect
    fill: {type: solid, color: "$muted"}

  - elementId: dim-rotor-label
    elementType: text
    bounds: [300, 164, 120, 16]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      text: "叶轮直径 216 m"

  # 尺寸标注：叶片
  - elementId: dim-blade-label
    elementType: text
    bounds: [262, 128, 110, 16]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      text: "叶片长 106 m"

  # 尺寸标注：塔架
  - elementId: dim-tower-label
    elementType: text
    bounds: [262, 296, 150, 32]
    content:
      text: |
        <p style="font-size:11px; color:$muted; font-family:MiSans;">139 m 混塔</p>
        <p style="font-size:11px; color:$muted; font-family:MiSans;">+ 16.8 m 钢塔</p>

  - elementId: schematic-caption
    elementType: text
    bounds: [140, 392, 220, 18]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      align: [center, top]
      text: "7.15 MW 级大型风电机组（示意）"

  # 右栏：参数表
  - elementId: param-table
    elementType: table
    bounds: [480, 124, 416, 300]
    content:
      style: $default
      colWidths: [0.4, 0.6]
      rowHeights: [0.13, 0.1228, 0.1228, 0.1228, 0.1228, 0.1228, 0.1228, 0.1228]
      rows:
        - ["参数", "数值"]
        - [{text: "总装机容量", style: {align: [left, middle], bold: true}}, "299.85 MW"]
        - [{text: "机组配置", style: {align: [left, middle], bold: true}}, "39×7.15 MW + 3×7.0 MW"]
        - [{text: "轮毂中心高度", style: {align: [left, middle], bold: true}}, "160 m"]
        - [{text: "叶轮直径", style: {align: [left, middle], bold: true}}, "216 m"]
        - [{text: "叶片长度", style: {align: [left, middle], bold: true}}, "106 m"]
        - [{text: "塔架结构", style: {align: [left, middle], bold: true}}, "139 m 混塔 + 16.8 m 钢塔"]
        - [{text: "子项目构成", style: {align: [left, middle], bold: true}}, "新发10万千瓦 + 新兴20万千瓦"]

  - elementId: mix-note
    elementType: text
    bounds: [480, 440, 416, 40]
    content:
      fontSize: 11
      color: "$muted"
      fontFamily: MiSans
      lineHeight: 1.5
      text: "混塔（混凝土-钢混合塔架）降低钢材用量与造价，适配大兆瓦机组高塔架需求"

  - elementId: footer-rule
    elementType: shape
    bounds: [64, 505, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: source-note
    elementType: text
    bounds: [64, 512, 560, 20]
    content:
      style: "$caption"
      text: "资料来源：龙船风电网、国际新能源网公开报道（2025.07–2025.12）"