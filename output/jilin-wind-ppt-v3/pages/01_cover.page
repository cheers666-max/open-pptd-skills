pageType: cover
background:
  type: solid
  color: "$deep"
notes: 封面：吉林化纤自带负荷配置30万千瓦风电项目，绿电直供，2025年12月并网。
elements:
  - elementId: bg-image
    elementType: image
    bounds: [0, 0, 960, 540]
    src: media/wind_cover.jpg
    fit: cover

  - elementId: overlay-lr
    elementType: shape
    bounds: [0, 0, 960, 540]
    shapeName: rect
    fill:
      type: gradient
      angle: 0
      stops:
        - {position: 0, color: "#0A1229F2"}
        - {position: 0.5, color: "#0A1229CC"}
        - {position: 1, color: "#0A122940"}

  - elementId: overlay-bottom
    elementType: shape
    bounds: [0, 300, 960, 240]
    shapeName: rect
    fill:
      type: gradient
      angle: 90
      stops:
        - {position: 0, color: "#0A122900"}
        - {position: 1, color: "#0A1229E6"}

  - elementId: brand
    elementType: text
    bounds: [64, 40, 600, 20]
    content:
      fontSize: 11
      color: "$frost"
      fontFamily: MiSans
      letterSpacing: 2
      text: "JILIN FIBER × CHN ENERGY · 央地协同绿电项目"

  - elementId: kicker
    elementType: text
    bounds: [64, 148, 700, 24]
    content:
      fontSize: 13
      color: "$accentLight"
      fontFamily: 阿里妈妈数黑体
      bold: true
      letterSpacing: 3
      text: "自带负荷配置 · 绿电直供 · 2025年12月并网"

  - elementId: title
    elementType: text
    bounds: [64, 176, 760, 132]
    content:
      text: |
        <p style="font-size:52px; color:#FFFFFF; font-family:阿里妈妈数黑体; font-weight:bold; line-height:1.25;">吉林化纤</p>
        <p style="font-size:52px; color:#FFFFFF; font-family:阿里妈妈数黑体; font-weight:bold; line-height:1.25;">30万千瓦风电项目</p>

  - elementId: title-tick
    elementType: shape
    bounds: [64, 318, 120, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: subtitle
    elementType: text
    bounds: [64, 338, 720, 24]
    content:
      fontSize: 14
      color: "$frost"
      fontFamily: MiSans
      text: "吉林省白城市通榆县乌兰花镇 · 299.85 MW · 年均发电 6.5 亿千瓦时"

  - elementId: stats-rule
    elementType: shape
    bounds: [64, 424, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF40"}

  - elementId: stat-1
    elementType: text
