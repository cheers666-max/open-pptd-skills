    content:
      text: |
        <p style="font-size:26px; color:#FFFFFF; font-family:阿里妈妈数黑体; font-weight:bold;">299.85<span style="font-size:13px; color:$frost;"> MW</span></p>
        <p style="font-size:11px; color:$frost; font-family:MiSans; margin-top:4px;">总装机容量</p>

  - elementId: stat-div-1
    elementType: shape
    bounds: [256, 442, 1, 46]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF33"}

  - elementId: stat-2
