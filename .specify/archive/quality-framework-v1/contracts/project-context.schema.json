{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-pptd:context:1.0",
  "title": "Open PPTD Project Context",
  "type": "object",
  "required": [
    "schemaVersion",
    "task",
    "design",
    "pages",
    "sources",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "open-pptd-context/1.0"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "purpose",
        "audience",
        "targetFormats",
        "pageCount",
        "editablePageIds",
        "expansionPolicy",
        "network",
        "allowDecorativeFallback",
        "deliveryPolicy",
        "editableResourcePaths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "create",
            "edit",
            "replicate"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "targetFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pptd",
              "pptx",
              "html",
              "png"
            ]
          }
        },
        "pageCount": {
          "type": "object",
          "required": [
            "mode",
            "value"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "flexible"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "editablePageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expansionPolicy": {
          "enum": [
            "none",
            "provided_material",
            "authorized_research"
          ]
        },
        "network": {
          "type": "object",
          "required": [
            "research",
            "images",
            "vlm"
          ],
          "properties": {
            "research": {
              "type": "boolean"
            },
            "images": {
              "type": "boolean"
            },
            "vlm": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "allowDecorativeFallback": {
          "type": "boolean"
        },
        "editableResourcePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deliveryPolicy": {
          "type": "object",
          "required": [
            "version",
            "origin",
            "allowedDegradations"
          ],
          "properties": {
            "version": {
              "const": "open-pptd-delivery/1.0"
            },
            "origin": {
              "enum": [
                "default",
                "user_instruction"
              ]
            },
            "authorizationRef": {
              "type": "string",
              "minLength": 1
            },
            "allowedDegradations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "featureId",
                  "format",
                  "representation",
                  "pageIds",
                  "elementIds",
                  "reason",
                  "authorizationRef"
                ],
                "properties": {
                  "featureId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "enum": [
                      "pptx",
                      "html",
                      "png"
                    ]
                  },
                  "representation": {
                    "enum": [
                      "vector",
                      "raster",
                      "fallback"
                    ]
                  },
                  "pageIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "elementIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authorizationRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "origin": {
                    "const": "default"
                  }
                }
              },
              "then": {
                "properties": {
                  "allowedDegradations": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "origin": {
                    "const": "user_instruction"
                  }
                }
              },
              "then": {
                "required": [
                  "authorizationRef"
                ]
              }
            }
          ]
        }
      }
    },
    "design": {
      "type": "object",
      "required": [
        "referencePath",
        "constraints"
      ],
      "properties": {
        "referencePath": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokens": {
          "type": "object"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "editBaseline": {
      "type": "object",
      "required": [
        "taskId",
        "manifestHash",
        "pageHashes",
        "mediaHashes",
        "sharedResourceHashes",
        "resourceRefsByPage"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pageHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "mediaHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "sharedResourceHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "resourceRefsByPage": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": [
        "id",
        "pageRef",
        "role",
        "objective",
        "takeaway",
        "prerequisites",
        "claimIds",
        "layoutIntent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pageRef": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "takeaway": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "layoutIntent": {
          "type": "string",
          "minLength": 1
        },
        "continuityGroup": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "uri",
        "locator",
        "accessStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "web",
            "local",
            "user"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "snapshotPath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accessStatus": {
          "enum": [
            "accessed",
            "unavailable",
            "not_checked"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "claimId",
        "pageId",
        "contentPath",
        "representation"
      ],
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "contentPath": {
          "type": "string",
          "pattern": "^/"
        },
        "representation": {
          "enum": [
            "text",
            "table",
            "chart",
            "notes"
          ]
        },
        "expectedText": {
          "type": "string"
        },
        "expectedValue": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "notes"
              }
            }
          },
          "then": {
            "properties": {
              "contentPath": {
                "const": "/notes"
              }
            },
            "not": {
              "required": [
                "elementId"
              ]
            }
          },
          "else": {
            "required": [
              "elementId"
            ]
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "statement",
        "sourceIds",
        "bindings",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "external_fact",
            "user_fact",
            "derived",
            "illustrative",
            "assumption"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metric": {
          "type": "object",
          "required": [
            "id",
            "value",
            "unit",
            "scope"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "number",
                "string"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "object",
              "properties": {
                "period": {
                  "type": "string",
                  "minLength": 1
                },
                "geography": {
                  "type": "string",
                  "minLength": 1
                },
                "population": {
                  "type": "string",
                  "minLength": 1
                },
                "denominator": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "enum": [
                    "actual",
                    "estimate",
                    "forecast",
                    "target",
                    "theoretical",
                    "measured"
                  ]
                }
              }
            }
          }
        },
        "derivation": {
          "type": "object",
          "required": [
            "inputClaimIds",
            "operation"
          ],
          "properties": {
            "inputClaimIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "operation": {
              "enum": [
                "sum",
                "difference",
                "product",
                "ratio",
                "percent_change",
                "unit_convert"
              ]
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "method",
            "sourceLocators",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "unreviewed",
                "supported",
                "disputed",
                "inconclusive"
              ]
            },
            "method": {
              "enum": [
                "author",
                "material_check"
              ]
            },
            "sourceLocators": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reviewedInputHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external_fact"
              }
            }
          },
          "then": {
            "properties": {
              "sourceIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "derivation"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "operation": {
                "const": "edit"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "editBaseline"
        ]
      }
    }
  ]
}
